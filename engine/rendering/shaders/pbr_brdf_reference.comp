#version 450
#extension GL_GOOGLE_include_directive : require
#include "pbr_brdf.glsl"
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) writeonly buffer ReferenceOutput { vec4 result; } outputData;
void main() {
    outputData.result = vec4(arutPbrEvaluateDirect(
        vec3(0.0, 0.0, 1.0), vec3(0.0, 0.0, 1.0), vec3(0.6, 0.0, 0.8),
        vec3(0.8, 0.2, 0.1), 0.2, 0.35, vec3(3.0, 2.0, 1.0)), 1.0);
}
