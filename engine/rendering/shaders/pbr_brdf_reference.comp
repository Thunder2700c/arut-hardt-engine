#version 450
#extension GL_GOOGLE_include_directive : require
#include "pbr_brdf.glsl"
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) writeonly buffer ReferenceOutput { vec4 results[]; } outputData;

void main() {
    uint index = gl_GlobalInvocationID.x;
    vec3 value;
    if (index == 0u) {
        value = arutPbrEvaluateDirect(
            vec3(0.0, 0.0, 1.0), vec3(0.0, 0.0, 1.0), vec3(0.6, 0.0, 0.8),
            vec3(0.8, 0.2, 0.1), 0.2, 0.35, vec3(3.0, 2.0, 1.0));
    } else if (index == 1u) {
        value = arutPbrEvaluateDirect(
            vec3(0.0, 0.0, 1.0), vec3(0.0, 0.0, 1.0), vec3(0.0, 0.0, 1.0),
            vec3(0.78, 0.42, 0.18), 0.0, 0.5, vec3(2.0, 1.5, 0.75));
    } else if (index == 2u) {
        value = arutPbrEvaluateDirect(
            vec3(0.0, 0.0, 1.0), vec3(0.0, 0.0, 1.0), vec3(0.3, 0.4, 0.8660254),
            vec3(0.7, 0.7, 0.7), 1.0, 0.9, vec3(1.0, 2.0, 4.0));
    } else if (index == 3u) {
        value = arutPbrEvaluateDirect(
            vec3(0.0, 0.0, 1.0), vec3(0.0, 0.0, 1.0), vec3(0.0, 0.0, -1.0),
            vec3(0.8, 0.2, 0.1), 0.5, 0.045, vec3(3.0, 2.0, 1.0));
    } else {
        return;
    }
    outputData.results[index] = vec4(value, 1.0);
}
